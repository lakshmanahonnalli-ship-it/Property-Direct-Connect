# ==========================================
# PropertyConnect - Environment Configuration
# ==========================================

# Backend (backend/.env)
PORT=5000
NODE_ENV=development
# Replace with your MongoDB Atlas connection string (or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/propertyconnect
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_characters
CLIENT_URL=http://localhost:5173

# Cloudinary (Optional - local disk fallback active if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend (frontend/.env)
VITE_API_URL=/api
